{
  "name": "final-form-quiz",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "packages/*",
    "simulation"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b --pretty false",
    "preview": "vite preview",
    "content:seed": "node content-pipeline/scripts/seed.mjs",
    "content:export": "node content-pipeline/scripts/export.mjs",
    "content:validate-migration": "node content-pipeline/scripts/validateCanonicalMigration.mjs",
    "content:validate": "node content-pipeline/scripts/validateCanonicalMigration.mjs && node content-pipeline/scripts/validateContent.mjs",
    "rarity:validate": "node content-pipeline/scripts/validateHybridRarity.mjs",
    "sim:run": "npm run run -w simulation",
    "sim:build-rarity": "npm run build-rarity -w simulation",
    "sim:build-baselines": "npm run build-baselines -w simulation",
    "sim:build-appearance": "npm run build-appearance -w simulation"
  },
  "dependencies": {
    "@final-form/shared-types": "*",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.7.2",
    "vite": "^6.0.5"
  },
  "engines": {
    "node": ">=20"
  }
}
